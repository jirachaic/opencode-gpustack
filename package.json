{
  "name": "opencode-gpustack",
  "version": "0.1.0",
  "description": "Automatically discover GPUStack LLMs in OpenCode.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jirachaic/opencode-gpustack.git"
  },
  "homepage": "https://github.com/jirachaic/opencode-gpustack#readme",
  "bugs": {
    "url": "https://github.com/jirachaic/opencode-gpustack/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "bin": {
    "opencode-gpustack": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts ./src/types.ts --outdir ./dist --target bun --format esm && tsc -p tsconfig.build.json",
    "check": "bun run check:package-versions && bun run typecheck && bun run lint && bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:integration": "bun test tests/integration.test.ts",
    "test:opencode": "bun run build && bun test ./tests/opencode.e2e.ts",
    "test:package": "bun run build && bun ./scripts/package-smoke.ts",
    "check:release-name": "bun ./scripts/check-release-name.ts",
    "check:package-versions": "bun ./scripts/check-package-versions.ts",
    "test:jsr": "bun run check:package-versions && bunx jsr publish --dry-run --allow-dirty",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run check && bun run build"
  },
  "keywords": [
    "opencode",
    "gpustack",
    "llm",
    "plugin",
    "model-discovery"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.21"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@opencode-ai/plugin": "^1.18.21",
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2"
  }
}
